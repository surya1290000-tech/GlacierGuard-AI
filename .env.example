# =============================================================================
# GlacierGuard-AI — Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to .env for optional local environment configuration:
#   cp .env.example .env
#
# CRITICAL SECURITY NOTE:
# Real credentials must NEVER be committed to Git. The .gitignore is configured
# to block all .env files (except .env.example).
#
# Preferred credential storage locations:
#   1. CDSE OAuth:  ~/.glacierguard/cdse_credentials.json (current user read/write)
#   2. CDS API:     ~/.cdsapirc (current user read/write)
# =============================================================================

# ── Copernicus Data Space Ecosystem (CDSE) / Sentinel Hub OAuth ───────────────
# Register and generate OAuth client credentials at:
# https://dataspace.copernicus.eu/ (User Dashboard -> API Keys / OAuth)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# ── Climate Data Store (CDS / ERA5-Land) ──────────────────────────────────────
# Obtain your CDS API key from:
# https://cds.climate.copernicus.eu/
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# ── Optional Databricks Workspace Configuration ──────────────────────────────
# DATABRICKS_HOST=https://dbc-0be231d6-04fb.cloud.databricks.com
# DATABRICKS_TOKEN=
